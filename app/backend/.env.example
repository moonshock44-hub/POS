# =============================================================================
# SECURITY CHECKLIST (do this before any non-local deploy)
# -----------------------------------------------------------------------------
# [ ] JWT_SECRET: long random string, >=32 chars (never use the placeholder below).
#     Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# [ ] Rotate JWT_SECRET if leaked → all sessions invalidate; users must re-login.
# [ ] SEED_ADMIN_PASSWORD: change from default; local bootstrap only (not production IAM).
# [ ] COOKIE_SECURE=true when serving over HTTPS (pairs with SameSite=None).
#     Local HTTP: false → SameSite=Lax (see auth._cookie_flags).
# [ ] JWT_EXPIRE_MINUTES: POS default 720 (12h). Avoid 24h+ unless you accept risk.
# [ ] MinIO/S3: defaults minioadmin/minioadmin are DEV ONLY — change Access/Secret keys.
# [ ] Never commit real `.env` (gitignored). Copy this file → `.env` and fill locally.
# =============================================================================

MONGO_URL=mongodb://localhost:27017
DB_NAME=pos_tienditas
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Administrador

# Rate limits (in-memory, per client IP). 0 = disable that bucket.
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_MIN=3
RATE_LIMIT_SETTINGS_WRITE_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=10

# Object storage (MinIO local / S3-compatible). Mongo stores only image_url, never Base64.
# WARNING: minioadmin/minioadmin are insecure defaults — change before any shared/prod use.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pos-tienditas
S3_REGION=us-east-1
S3_PUBLIC_READ=true
